# ==============================================================================
# Campus Lost & Found Portal - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENV=production
FLASK_DEBUG=0
GUNICORN_WORKERS=2
NUM_PROXIES=1

# Secret Key (Generate with: openssl rand -hex 32)
# REQUIRED in production. Application will fail to start if default is used.
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-hex-string

# JWT Lifetime in hours
JWT_EXPIRY_HOURS=24

# Administrator Setup
# ADMIN_EMAILS: Informational or operator emails
ADMIN_EMAILS=admin@campus.edu
# ADMIN_BOOTSTRAP_TOKEN: Required to bootstrap the initial admin via registration header X-Admin-Bootstrap-Token
ADMIN_BOOTSTRAP_TOKEN=generate-a-secure-bootstrap-token

# Database Configuration (MySQL 8.4)
MYSQL_DATABASE=lost_found_portal
MYSQL_USER=lostfound
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Docker Compose Production Image Settings
IMAGE_PREFIX=ghcr.io/sushantapatil2006
IMAGE_TAG=latest

# Storage Backend: auto, gcs, oci, local
STORAGE_BACKEND=auto

# --- Google Cloud Storage (GCS) ---
# Used when deploying on Google Cloud Compute Engine
GCS_BUCKET=campus-lost-and-found-images
GCP_PROJECT_ID=your-gcp-project-id

# --- Oracle Cloud Infrastructure (OCI) Object Storage ---
# Used if deploying with OCI Object Storage bucket
OCI_NAMESPACE=
OCI_BUCKET=
OCI_REGION=
OCI_CONFIG_FILE=/root/.oci/config
OCI_PROFILE=DEFAULT
